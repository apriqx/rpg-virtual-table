datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  username        String          @unique
  passwordHash    String
  role            String          @default("PLAYER")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tables          TableMember[]
  ownedTables     Table[]         @relation("TableOwner")
  ownedTokens     Token[]         @relation("TokenOwner")
  tokenPermissions TokenPermission[]
  chatMessages    ChatMessage[]
  characters      Character[]
  characterPermissions CharacterPermission[]
}

model Table {
  id          String        @id @default(uuid())
  name        String
  description String?
  masquerade  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ownerId     String
  owner       User          @relation("TableOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TableMember[]
  maps        Map[]
  messages    ChatMessage[]
  characters  Character[]
  sheets      Sheet[]
}

model TableMember {
  id       String   @id @default(uuid())
  tableId  String
  table    Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("PLAYER")
  muted    Boolean  @default(false)
  activeMapId String?
  joinedAt DateTime @default(now())

  @@unique([tableId, userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String?
  type      String   @default("player")
  text      String
  whisperTo String?
  createdAt DateTime @default(now())

  @@index([tableId, createdAt])
}

model Character {
  id        String    @id @default(uuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  system    String    @default("custom")
  kind      String    @default("pc")
  data      Json      @default("{\"hp\":{\"current\":0,\"max\":0,\"temp\":0}}")
  visibleToPlayers Boolean @default(false)
  tokens    Token[]
  permissions CharacterPermission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tableId])
}

model CharacterPermission {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  canView     Boolean   @default(true)
  canControl  Boolean   @default(false)

  @@unique([characterId, userId])
}

model Map {
  id         String   @id @default(uuid())
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String
  darkMode   Boolean @default(false)
  bgImageUrl String?
  fgImageUrl String?
  mediaType  String   @default("image")
  width      Int
  height     Int
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tokens     Token[]
  gridConfig GridConfig?
  fogConfig  FogConfig?
  fogRegions FogOfWarRegion[]
  drawings   Drawing[]
  annotations Annotation[]
}

model Token {
  id           String     @id @default(uuid())
  mapId        String
  map          Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name         String
  imageUrl     String?
  type         String     @default("character")
  x            Float      @default(0)
  y            Float      @default(0)
  width        Float      @default(40)
  height       Float      @default(40)
  rotation     Float      @default(0)
  layer        Int        @default(2)
  visible      Boolean    @default(true)
  locked       Boolean    @default(false)
  snapToGrid   Boolean    @default(true)
  displayName  String?
  showName     Boolean    @default(true)
  opacity      Float      @default(1)
  bars         Json?
  statusMarkers Json?
  lightRadius  Float      @default(0)
  visionRadius Float      @default(0)
  ownerId      String?
  characterId  String?
  owner        User?      @relation("TokenOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  character    Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  permissions  TokenPermission[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TokenPermission {
  id        String @id @default(uuid())
  tokenId   String
  token     Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  canView   Boolean @default(true)
  canMove   Boolean @default(false)
  canResize Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([tokenId, userId])
}

model GridConfig {
  id            String  @id @default(uuid())
  mapId         String  @unique
  map           Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  cellSize      Float   @default(40)
  physicalSize  Float   @default(1.5)
  visible    Boolean  @default(true)
  lineThickness Float   @default(1)
  lineOpacity   Float   @default(0.5)
  offsetX       Float   @default(0)
  offsetY       Float   @default(0)
  snapToGrid    Boolean @default(false)
  distanceUnit  String  @default("m")
}

// Itens 19-24: folhas auxiliares da aventura (mestre cria; jogador ve apenas as visiveis, sem masterNotes)
model Sheet {
  id               String   @id @default(uuid())
  tableId          String
  table            Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  title            String
  imageUrl         String?
  comments         String   @default("")
  masterNotes      String   @default("")
  visibleToPlayers Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tableId])
}

model FogOfWarRegion {
  id       String @id @default(uuid())
  mapId    String
  map      Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x        Float
  y        Float
  width    Float
  height   Float
  revealed Boolean @default(false)
  shape    String  @default("rect")
  points   Json?
}

// Itens 16-24: configuracao visual da neblina por mapa (exclusiva do mestre)
model FogConfig {
  id            String  @id @default(uuid())
  mapId         String  @unique
  map           Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  enabled       Boolean @default(true)
  color         String  @default("#000000")
  masterOpacity Float   @default(0.5)
  playerOpacity Float   @default(0)
}

model Drawing {
  id        String   @id @default(uuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  color     String   @default("#e94560")
  lineWidth Float    @default(3)
  points    Json
  layer     Int      @default(0)
  createdAt DateTime @default(now())
}

model Annotation {
  id        String   @id @default(uuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  text      String
  x         Float
  y         Float
  color     String   @default("#ffffff")
  fontSize  Int      @default(16)
  createdAt DateTime @default(now())
}